# Local-only example. Copy to an untracked .env and fill in values.
# Never commit a real password, JWT secret, or machine-specific absolute path.
SERVER_PORT=8100
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eladmin
DB_USER=root
DB_PWD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SECURITY_MODEL_JWT_SECRET=
SECURITY_MODEL_JWT_VALIDITY=PT8H
SECURITY_MODEL_ADMIN_CROSS_USER_READ=false
SECURITY_MODEL_DISPATCH_PENDING_SCAN_AGE_SECONDS=30
SECURITY_MODEL_DISPATCH_PENDING_EXPIRE_SECONDS=300
SECURITY_MODEL_DISPATCH_SCAN_INTERVAL_MS=10000
SECURITY_MODEL_OBSERVABILITY_STALE_PROGRESS_SECONDS=600
SECURITY_MODEL_OBSERVABILITY_REFRESH_INTERVAL_MS=30000
